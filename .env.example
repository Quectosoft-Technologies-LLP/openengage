# ── OpenEngage Environment Variables ──────────────────────────

# Database
DATABASE_URL=postgresql://postgres:pass@localhost:5432/openengage

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM (Ollama)
OLLAMA_URL=http://ollama:11434

# ChromaDB
CHROMA_URL=http://chromadb:8001

# Mautic Core
MAUTIC_URL=http://mautic:80
MAUTIC_CLIENT_ID=your_mautic_client_id
MAUTIC_CLIENT_SECRET=your_mautic_client_secret

# ── Salesforce Integration ────────────────────────────────────
SF_CLIENT_ID=your_salesforce_connected_app_client_id
SF_CLIENT_SECRET=your_salesforce_connected_app_client_secret
SF_USERNAME=your_sf_username@example.com
SF_PASSWORD=your_sf_password
SF_SECURITY_TOKEN=your_sf_security_token
SF_INSTANCE_URL=https://login.salesforce.com
SF_WEBHOOK_SECRET=your_sf_webhook_hmac_secret

# ── HubSpot Integration ───────────────────────────────────────
HUBSPOT_API_KEY=pat-xxx-your-private-app-key
HUBSPOT_PORTAL_ID=your_hubspot_portal_id
HUBSPOT_WEBHOOK_SECRET=your_hs_webhook_hmac_secret
HS_TIMELINE_EVENT_TYPE_ID=1

# ── Adobe Marketo Migration ───────────────────────────────────
MARKETO_CLIENT_ID=your_marketo_client_id
MARKETO_CLIENT_SECRET=your_marketo_client_secret
MARKETO_BASE_URL=https://xxx-yyy-zzz.mktorest.com

# ── Web Tracker ───────────────────────────────────────────────
OE_TRACKER_SECRET=your_tracker_hmac_secret

# ── Email (Postal MTA) ────────────────────────────────────────
POSTAL_API_URL=http://postal:5000
POSTAL_API_KEY=your_postal_server_api_key

# ── Storage (MinIO) ───────────────────────────────────────────
MINIO_URL=http://minio:9000
MINIO_ACCESS_KEY=openengage
MINIO_SECRET_KEY=openengage123

# ── LLM Provider (default: ollama — fully local, no API key needed) ─────────
LLM_PROVIDER=ollama        # ollama | openai | claude | gemini | grok | llamacpp | azure_openai
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# Ollama (default — change model to any pulled model)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b      # alternatives: llama3.1:8b, gemma3:12b, mistral:7b

# OpenAI (set LLM_PROVIDER=openai to activate)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini   # or gpt-4o, o3-mini

# Anthropic Claude (set LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-3-5-haiku-20241022   # or claude-3-7-sonnet-20250219

# Google Gemini (set LLM_PROVIDER=gemini)
GOOGLE_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash   # or gemini-2.5-pro

# xAI Grok (set LLM_PROVIDER=grok)
GROK_API_KEY=xai-...
GROK_MODEL=grok-3-mini   # or grok-3
GROK_BASE_URL=https://api.x.ai/v1

# llama.cpp local server (set LLM_PROVIDER=llamacpp)
# Run: llama-server -m ./models/qwen3-8b-q4.gguf --port 8080 -c 4096
LLAMACPP_URL=http://localhost:8080
LLAMACPP_MODEL=local-model

# Azure OpenAI (set LLM_PROVIDER=azure_openai)
AZURE_OPENAI_KEY=...
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview
